#version 450

layout(set = 0, binding = 0) uniform UniformBuffer {
    uint binCount;
    uint radius;
    float d0;
} constants;

layout(set = 0, binding = 2) buffer HistogramBuffer {
    uint values[];
} histogram;

layout(set = 0, binding =  5) buffer integralBuffer000 { float values[]; } int000;
layout(set = 0, binding =  6) buffer integralBuffer001 { float values[]; } int001;
layout(set = 0, binding =  7) buffer integralBuffer010 { float values[]; } int010;
layout(set = 0, binding =  8) buffer integralBuffer011 { float values[]; } int011;
layout(set = 0, binding =  9) buffer integralBuffer100 { float values[]; } int100;
layout(set = 0, binding = 10) buffer integralBuffer101 { float values[]; } int101;
layout(set = 0, binding = 11) buffer integralBuffer110 { float values[]; } int110;
layout(set = 0, binding = 12) buffer integralBuffer111 { float values[]; } int111;

layout(set = 0, binding = 13, std140) buffer transformationBuffer { vec4 values[]; } transformation;

int getIndex(ivec3 x) {
    if(any(lessThan(x, ivec3(0)))) return -1;
    int bins = int(constants.binCount);
    return x.r + x.g * bins + x.b * bins * bins;
}

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
void main() {
    float maxBin = constants.binCount;

    ivec3 color = ivec3(gl_GlobalInvocationID.xyz);
    if(any(greaterThanEqual(color, uvec3(uint(constants.binCount))))) return;

    vec3 q000, q001, q010, q011, q100, q101, q110, q111;
    float x = color.x / float(maxBin);
    float y = color.y / float(maxBin);
    float z = color.z / float(maxBin);
    int i = color.x;
    int j = color.y;
    int k = color.z;

    // q000
    if (i <= j && i <= k) {
        q000 = vec3(0, y - x, z - x);
    } else if (j <= i && j <= k) {
        q000 = vec3(x - y, 0, z - y);
    } else {
        q000 = vec3(x - z, y - z, 0);
    }

    // q001
    if (i <= j && i <= (maxBin - k)) {
        q001 = vec3(0, y - x, z + x);
    } else if (j <= i && j <= (maxBin - k)) {
        q001 = vec3(x - y, 0, z + y);
    } else {
        q001 = vec3(x + z - 1, y + z - 1, 1);
    }

    // q010
    if (i <= (maxBin - j) && i <= k) {
        q010 = vec3(0, x + y, z - x);
    } else if ((maxBin - j) <= i && (maxBin - j) <= k) {
        q010 = vec3(x + y - 1, 1, y + z - 1);
    } else {
        q010 = vec3(x - z, y + z, 0);
    }

    // q011
    if (i <= (maxBin - j) && i <= (maxBin - k)) {
        q011 = vec3(0, x + y, x + z);
    } else if ((maxBin - j) <= i && (maxBin - j) <= (maxBin - k)) {
        q011 = vec3(x + y - 1, 1, z - y + 1);
    } else {
        q011 = vec3(x + z - 1, y - z + 1, 1);
    }

    // q100
    if ((maxBin - i) <= j && (maxBin - i) <= k) {
        q100 = vec3(1, x + y - 1, x + z - 1);
    } else if (j <= (maxBin - i) && j <= k) {
        q100 = vec3(x + y, 0, z - y);
    } else {
        q100 = vec3(x + z, y - z, 0);
    }

    // q101
    if ((maxBin - i) <= j && (maxBin - i) <= (maxBin - k)) {
        q101 = vec3(1, x + y - 1, z - x + 1);
    } else if (j <= (maxBin - i) && j <= (maxBin - k)) {
        q101 = vec3(x + y, 0, y + z);
    } else {
        q101 = vec3(x - z + 1, y + z - 1, 1);
    }

    // q110
    if ((maxBin - i) <= (maxBin - j) && (maxBin - i) <= k) {
        q110 = vec3(1, y - x + 1, z + x - 1);
    } else if ((maxBin - j) <= (maxBin - i) && (maxBin - j) <= k) {
        q110 = vec3(x - y + 1, 1, z + y - 1);
    } else {
        q110 = vec3(x + z, y + z, 0);
    }

    // q111
    if ((maxBin - i) <= (maxBin - j) && (maxBin - i) <= (maxBin - k)) {
        q111 = vec3(1, y - x + 1, z - x + 1);
    } else if ((maxBin - j) <= (maxBin - i) && (maxBin - j) <= (maxBin - k)) {
        q111 = vec3(x - y + 1, 1, z - y + 1);
    } else {
        q111 = vec3(x - z + 1, y - z + 1, 1);
    }

    uint index = getIndex(color);
    float weight000 = int000.values[index];
    float weight001 = int001.values[index];
    float weight010 = int010.values[index];
    float weight011 = int011.values[index];
    float weight100 = int100.values[index];
    float weight101 = int101.values[index];
    float weight110 = int110.values[index];
    float weight111 = int111.values[index];

    /*uint index = getIndex(color);
    uint index000 = getIndex(ivec3(i-1, j-1, k-1));
    float weight000 = index000 == -1 ? 0 :  int000.values[index000];

    uint index001 = getIndex(ivec3(i-1, j-1, k));
    float weight001 = index001 == -1 ? 0 :  int001.values[index001];

    uint index010 = getIndex(ivec3(i-1, j, k-1));
    float weight010 = index010 == -1 ? 0 :  int010.values[index010];

    uint index011 = getIndex(ivec3(i-1, j, k));
    float weight011 = index011 == -1 ? 0 :  int011.values[index011];

    uint index100 = getIndex(ivec3(i, j-1, k-1));
    float weight100 = index100 == -1 ? 0 :  int100.values[index100];

    uint index101 = getIndex(ivec3(i, j-1, k));
    float weight101 = index101 == -1 ? 0 :  int101.values[index101];

    uint index110 = getIndex(ivec3(i, j, k-1));
    float weight110 = index110 == -1 ? 0 :  int110.values[index110];

    uint index111 = getIndex(ivec3(i, j, k));
    float weight111 = index111 == -1 ? 0 :  int111.values[index111];*/

    float sumWeights = weight000 + weight001 + weight010 + weight011 + weight100 + weight101 + weight110 + weight111;

    vec3 map 
        = q111 * weight000
        + q110 * weight001
        + q101 * weight010
        + q100 * weight011
        + q011 * weight100
        + q010 * weight101
        + q001 * weight110
        + q000 * weight111;

    map *= float(maxBin) / sumWeights;
    transformation.values[getIndex(color)] = vec4(map, 0);
    histogram.values[getIndex(color)] = 0;
}
