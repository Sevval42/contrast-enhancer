#version 450

/*
Adds the sums of both Y-directions to the integrals
*/

#define USE_ROTATED_INT 0

layout(set = 0, binding = 0) uniform UniformBuffer {
    uint bins;
    uint radius;
    float d0;
} constants;

layout(set = 0, binding =  5) buffer integralBuffer000 { float values[]; } int000;
layout(set = 0, binding =  6) buffer integralBuffer001 { float values[]; } int001;
layout(set = 0, binding =  7) buffer integralBuffer010 { float values[]; } int010;
layout(set = 0, binding =  8) buffer integralBuffer011 { float values[]; } int011;
layout(set = 0, binding =  9) buffer integralBuffer100 { float values[]; } int100;
layout(set = 0, binding = 10) buffer integralBuffer101 { float values[]; } int101;
layout(set = 0, binding = 11) buffer integralBuffer110 { float values[]; } int110;
layout(set = 0, binding = 12) buffer integralBuffer111 { float values[]; } int111;

// Rotated integrals
layout(set = 0, binding = 13) buffer integralBufferX0 { float values[]; } intX0;
layout(set = 0, binding = 14) buffer integralBufferX1 { float values[]; } intX1;
layout(set = 0, binding = 15) buffer integralBufferY0 { float values[]; } intY0;
layout(set = 0, binding = 16) buffer integralBufferY1 { float values[]; } intY1;
layout(set = 0, binding = 17) buffer integralBufferZ0 { float values[]; } intZ0;
layout(set = 0, binding = 18) buffer integralBufferZ1 { float values[]; } intZ1;

// Temp buffer for rotated integrals
layout(set = 0, binding = 19) buffer tempIntBufferX0 { float values[]; } tempX0;
layout(set = 0, binding = 20) buffer tempIntBufferX1 { float values[]; } tempX1;
layout(set = 0, binding = 21) buffer tempIntBufferY0 { float values[]; } tempY0;
layout(set = 0, binding = 22) buffer tempIntBufferY1 { float values[]; } tempY1;
layout(set = 0, binding = 23) buffer tempIntBufferZ0 { float values[]; } tempZ0;
layout(set = 0, binding = 24) buffer tempIntBufferZ1 { float values[]; } tempZ1;

int getIndex(ivec3 x) {
    int bins = int(constants.bins);
    return x.r + x.g * bins + x.b * bins * bins;
}

int getIndexTemp(int n, ivec3 x) {
    int bins = int(constants.bins);
    if(any(lessThan(x, ivec3(0)))) return -1;
    if(any(greaterThanEqual(x, ivec3(bins)))) return -1;
    return getIndex(x) + n * bins * bins * bins;
}

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;
void main() {
    int bins = int(constants.bins);
    ivec2 row = ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(row, ivec2(bins)))) return;

    float sum00 = int000.values[getIndex(ivec3(row.x, 0, row.y))];
    float sum01 = int010.values[getIndex(ivec3(row.x, bins-1, row.y))];
    float sum10 = int100.values[getIndex(ivec3(row.x, 0, row.y))];
    float sum11 = int110.values[getIndex(ivec3(row.x, bins-1, row.y))];

#if USE_ROTATED_INT
    // left and right triangular accumulation for rotated integrals
    ivec3 iX0 = ivec3(0, row);
    ivec3 iX1 = ivec3(bins-1, row);
    ivec3 iY0 = ivec3(row.x, 0, row.y);
    ivec3 iY1 = ivec3(row.x, bins-1, row.y);
    ivec3 iZ0 = ivec3(row, 0);
    ivec3 iZ1 = ivec3(row, bins-1);

    tempX0.values[getIndexTemp(0, iX0)] = intX0.values[getIndex(iX0)];
    tempX0.values[getIndexTemp(1, iX0)] = intX0.values[getIndex(iX0)];
    tempX0.values[getIndexTemp(2, iX0)] = intX0.values[getIndex(iX0)];
    tempX0.values[getIndexTemp(3, iX0)] = intX0.values[getIndex(iX0)];

    tempX1.values[getIndexTemp(0, iX1)] = intX1.values[getIndex(iX1)];
    tempX1.values[getIndexTemp(1, iX1)] = intX1.values[getIndex(iX1)];
    tempX1.values[getIndexTemp(2, iX1)] = intX1.values[getIndex(iX1)];
    tempX1.values[getIndexTemp(3, iX1)] = intX1.values[getIndex(iX1)];

    tempY0.values[getIndexTemp(0, iY0)] = intY0.values[getIndex(iY0)];
    tempY0.values[getIndexTemp(1, iY0)] = intY0.values[getIndex(iY0)];
    tempY0.values[getIndexTemp(2, iY0)] = intY0.values[getIndex(iY0)];
    tempY0.values[getIndexTemp(3, iY0)] = intY0.values[getIndex(iY0)];

    tempY1.values[getIndexTemp(0, iY1)] = intY1.values[getIndex(iY1)];
    tempY1.values[getIndexTemp(1, iY1)] = intY1.values[getIndex(iY1)];
    tempY1.values[getIndexTemp(2, iY1)] = intY1.values[getIndex(iY1)];
    tempY1.values[getIndexTemp(3, iY1)] = intY1.values[getIndex(iY1)];

    tempZ0.values[getIndexTemp(0, iZ0)] = intZ0.values[getIndex(iZ0)];
    tempZ0.values[getIndexTemp(1, iZ0)] = intZ0.values[getIndex(iZ0)];
    tempZ0.values[getIndexTemp(2, iZ0)] = intZ0.values[getIndex(iZ0)];
    tempZ0.values[getIndexTemp(3, iZ0)] = intZ0.values[getIndex(iZ0)];

    tempZ1.values[getIndexTemp(0, iZ1)] = intZ1.values[getIndex(iZ1)];
    tempZ1.values[getIndexTemp(1, iZ1)] = intZ1.values[getIndex(iZ1)];
    tempZ1.values[getIndexTemp(2, iZ1)] = intZ1.values[getIndex(iZ1)];
    tempZ1.values[getIndexTemp(3, iZ1)] = intZ1.values[getIndex(iZ1)];
#endif

    for(int i = 1; i < bins; ++i) {
        int index0 = getIndex(ivec3(row.x, i, row.y));
        int index1 = getIndex(ivec3(row.x, bins-1-i, row.y));
        sum00 += int000.values[index0];
        sum01 += int010.values[index1];
        sum10 += int100.values[index0];
        sum11 += int110.values[index1];

        int000.values[index0] = sum00;
        int001.values[index0] = sum00;
        int010.values[index1] = sum01;
        int011.values[index1] = sum01;
        int100.values[index0] = sum10;
        int101.values[index0] = sum10;
        int110.values[index1] = sum11;
        int111.values[index1] = sum11;

#if USE_ROTATED_INT
        int xShiftRight = (row.x+i)%bins;
        int xShiftLeft = (row.x-i+bins)%bins;

        // X0 and X1
        int lowerIndex = getIndexTemp(0, ivec3(i-1, xShiftRight - 1, row.y));
        float sumLeft = (lowerIndex == -1 ? 0 : tempX0.values[lowerIndex])
            + intX0.values[getIndex(ivec3(i, xShiftRight, row.y))];

        lowerIndex = getIndexTemp(2, ivec3(i-1, xShiftLeft + 1, row.y));
        float sumRight = (lowerIndex == -1 ? 0 : tempX0.values[lowerIndex])
            + intX0.values[getIndex(ivec3(i, xShiftLeft, row.y))];

        tempX0.values[getIndexTemp(0, ivec3(i, xShiftRight, row.y))] = sumLeft;
        tempX0.values[getIndexTemp(1, ivec3(i, xShiftRight, row.y))] = sumLeft;
        tempX0.values[getIndexTemp(2, ivec3(i, xShiftLeft, row.y))] = sumRight;
        tempX0.values[getIndexTemp(3, ivec3(i, xShiftLeft, row.y))] = sumRight;


        lowerIndex = getIndexTemp(0, ivec3(bins-i, xShiftRight - 1, row.y));
        sumLeft = (lowerIndex == -1 ? 0 : tempX1.values[lowerIndex])
            + intX1.values[getIndex(ivec3(bins-1-i, xShiftRight, row.y))];

        lowerIndex = getIndexTemp(2, ivec3(bins-i, xShiftLeft + 1, row.y));
        sumRight = (lowerIndex == -1 ? 0 : tempX1.values[lowerIndex])
            + intX1.values[getIndex(ivec3(bins-1-i, xShiftLeft, row.y))];
        
        tempX1.values[getIndexTemp(0, ivec3(bins-1-i, xShiftRight, row.y))] = sumLeft;
        tempX1.values[getIndexTemp(1, ivec3(bins-1-i, xShiftRight, row.y))] = sumLeft;
        tempX1.values[getIndexTemp(2, ivec3(bins-1-i, xShiftLeft, row.y))] = sumRight;
        tempX1.values[getIndexTemp(3, ivec3(bins-1-i, xShiftLeft, row.y))] = sumRight;


        // Y0 and Y1
        lowerIndex = getIndexTemp(0, ivec3(xShiftRight - 1, i-1, row.y));
        sumLeft = (lowerIndex == -1 ? 0 : tempY0.values[lowerIndex])
            + intY0.values[getIndex(ivec3(xShiftRight, i,row.y))];

        lowerIndex = getIndexTemp(2, ivec3(xShiftLeft + 1, i-1, row.y));
        sumRight = (lowerIndex == -1 ? 0 : tempY0.values[lowerIndex])
            + intY0.values[getIndex(ivec3(xShiftLeft, i,row.y))];
        
        tempY0.values[getIndexTemp(0, ivec3(xShiftRight, i, row.y))] = sumLeft;
        tempY0.values[getIndexTemp(1, ivec3(xShiftRight, i, row.y))] = sumLeft;
        tempY0.values[getIndexTemp(2, ivec3(xShiftLeft, i, row.y))] = sumRight;
        tempY0.values[getIndexTemp(3, ivec3(xShiftLeft, i, row.y))] = sumRight;


        lowerIndex = getIndexTemp(0, ivec3(xShiftRight - 1, bins-i, row.y));
        sumLeft = (lowerIndex == -1 ? 0 : tempY1.values[lowerIndex])
            + intY1.values[getIndex(ivec3(xShiftRight, bins-1-i, row.y))];

        lowerIndex = getIndexTemp(2, ivec3(xShiftLeft + 1, bins-i, row.y));
        sumRight = (lowerIndex == -1 ? 0 : tempY1.values[lowerIndex])
            + intY1.values[getIndex(ivec3(xShiftLeft, bins-1-i, row.y))];

        tempY1.values[getIndexTemp(0, ivec3(xShiftRight, bins-1-i, row.y))] = sumLeft;
        tempY1.values[getIndexTemp(1, ivec3(xShiftRight, bins-1-i, row.y))] = sumLeft;
        tempY1.values[getIndexTemp(2, ivec3(xShiftLeft, bins-1-i, row.y))] = sumRight;
        tempY1.values[getIndexTemp(3, ivec3(xShiftLeft, bins-1-i, row.y))] = sumRight;
        

        // Z0 and Z1
        lowerIndex = getIndexTemp(0, ivec3(xShiftRight - 1, row.y, i-1));
        sumLeft = (lowerIndex == -1 ? 0 : tempZ0.values[lowerIndex])
            + intZ0.values[getIndex(ivec3(xShiftRight, row.y, i))];

        lowerIndex = getIndexTemp(2, ivec3(xShiftLeft + 1, row.y, i-1));
        sumRight = (lowerIndex == -1 ? 0 : tempZ0.values[lowerIndex])
            + intZ0.values[getIndex(ivec3(xShiftLeft, row.y, i))];
        
        tempZ0.values[getIndexTemp(0, ivec3(xShiftRight, row.y, i))] = sumLeft;
        tempZ0.values[getIndexTemp(1, ivec3(xShiftRight, row.y, i))] = sumLeft;
        tempZ0.values[getIndexTemp(2, ivec3(xShiftLeft, row.y, i))] = sumRight;
        tempZ0.values[getIndexTemp(3, ivec3(xShiftLeft, row.y, i))] = sumRight;


        lowerIndex = getIndexTemp(0, ivec3(xShiftRight - 1, row.y, bins-i));
        sumLeft = (lowerIndex == -1 ? 0 : tempZ1.values[lowerIndex])
            + intZ1.values[getIndex(ivec3(xShiftRight, row.y, bins-1-i))];

        lowerIndex = getIndexTemp(2, ivec3(xShiftLeft + 1, row.y, bins-i));
        sumRight = (lowerIndex == -1 ? 0 : tempZ1.values[lowerIndex])
            + intZ1.values[getIndex(ivec3(xShiftLeft, row.y, bins-1-i))];
        
        tempZ1.values[getIndexTemp(0, ivec3(xShiftRight, row.y, bins-1-i))] = sumLeft;
        tempZ1.values[getIndexTemp(1, ivec3(xShiftRight, row.y, bins-1-i))] = sumLeft;
        tempZ1.values[getIndexTemp(2, ivec3(xShiftLeft, row.y, bins-1-i))] = sumRight;
        tempZ1.values[getIndexTemp(3, ivec3(xShiftLeft, row.y, bins-1-i))] = sumRight;
#endif

    }
}
