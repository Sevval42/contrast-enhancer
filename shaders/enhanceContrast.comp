#version 450

layout(set = 0, binding = 0) uniform UniformBuffer {
    uint binCount;
    uint radius;
    float d0;
} constants;

layout(set = 0, binding = 1, rgba32f) uniform image2D img;

layout(set = 0, binding = 13) buffer transformationBuffer { vec4 values[]; } transformation;

layout(set = 0, binding = 14) buffer baseTransformationBuffer { vec4 values[]; } baseTransformation;

uint getIndex(uvec3 x) {
    uint bins = constants.binCount;
    return x.r + x.g * bins + x.b * bins * bins;
}


uint hash( uint x ) {
    x += ( x << 10u );
    x ^= ( x >>  6u );
    x += ( x <<  3u );
    x ^= ( x >> 11u );
    x += ( x << 15u );
    return x;
}

// Compound versions of the hashing algorithm I whipped together.
uint hash( uvec2 v ) { return hash( v.x ^ hash(v.y)                         ); }
uint hash( uvec3 v ) { return hash( v.x ^ hash(v.y ^ hash(v.z))             ); }
uint hash( uvec4 v ) { return hash( v.x ^ hash(v.y ^ hash(v.z ^ hash(v.w))) ); }



// Construct a float with half-open range [0:1] using low 23 bits.
// All zeroes yields 0.0, all ones yields the next smallest representable value below 1.0.
float floatConstruct( uint m ) {
    const uint ieeeMantissa = 0x007FFFFFu; // binary32 mantissa bitmask
    const uint ieeeOne      = 0x3F800000u; // 1.0 in IEEE binary32

    m &= ieeeMantissa;                     // Keep only mantissa bits (fractional part)
    m |= ieeeOne;                          // Add fractional part to 1.0

    float  f = uintBitsToFloat( m );       // Range [1:2]
    return f - 1.0;                        // Range [0:1]
}

vec3 random(vec2 v) {
    float x = floatConstruct(hash(floatBitsToUint(v)));
    float y = floatConstruct(hash(floatBitsToUint(vec3(v, x))));
    float z = floatConstruct(hash(floatBitsToUint(vec4(v, x, y))));
    return vec3(x, y, z);
}

layout(local_size_x = 16, local_size_y = 16) in;
void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoords.x >= imageSize(img).x || pixelCoords.y >= imageSize(img).y) {
        return;
    }

    float maxBin = constants.binCount-1;
    vec4 color = imageLoad(img, pixelCoords) + vec4((random(pixelCoords)*2.0-1.0)*5e-6, 0);
    color *= maxBin;

    /* 1. Ansatz
    uint rBin = min(uint(floor(color.r)), constants.binCount - 1u);
    uint gBin = min(uint(floor(color.g)), constants.binCount - 1u);
    uint bBin = min(uint(floor(color.b)), constants.binCount - 1u);

    uint binIndex = rBin + gBin * constants.binCount + bBin * constants.binCount * constants.binCount;
    vec3 newColor = color.xyz + transformation.values[binIndex].xyz - baseTransformation.values[binIndex].xyz;*/

    // Interpolation
    float r0 = floor(color.x);
    float g0 = floor(color.y);
    float b0 = floor(color.z);
    float r1 = min(r0 + 1, constants.binCount-1u);
    float g1 = min(g0 + 1, constants.binCount-1u);
    float b1 = min(b0 + 1, constants.binCount-1u);

    float rd = color.x - r0;
    float gd = color.y - g0;
    float bd = color.z - b0;

    vec4 transf = 
        transformation.values[getIndex(uvec3(r0, g0, b0))] * (1-rd) * (1-gd) * (1-bd) +
        transformation.values[getIndex(uvec3(r1, g0, b0))] * rd * (1-gd) * (1-bd) +
        transformation.values[getIndex(uvec3(r0, g1, b0))] * (1-rd) * gd * (1-bd) +
        transformation.values[getIndex(uvec3(r1, g1, b0))] * rd * gd * (1-bd) +
        transformation.values[getIndex(uvec3(r0, g0, b1))] * (1-rd) * (1-gd) * bd +
        transformation.values[getIndex(uvec3(r1, g0, b1))] * rd * (1-gd) * bd +
        transformation.values[getIndex(uvec3(r0, g1, b1))] * (1-rd) * gd * bd +
        transformation.values[getIndex(uvec3(r1, g1, b1))] * rd * gd * bd;

    vec4 d0transf = 
        baseTransformation.values[getIndex(uvec3(r0, g0, b0))] * (1-rd) * (1-gd) * (1-bd) +
        baseTransformation.values[getIndex(uvec3(r1, g0, b0))] * rd * (1-gd) * (1-bd) +
        baseTransformation.values[getIndex(uvec3(r0, g1, b0))] * (1-rd) * gd * (1-bd) +
        baseTransformation.values[getIndex(uvec3(r1, g1, b0))] * rd * gd * (1-bd) +
        baseTransformation.values[getIndex(uvec3(r0, g0, b1))] * (1-rd) * (1-gd) * bd +
        baseTransformation.values[getIndex(uvec3(r1, g0, b1))] * rd * (1-gd) * bd +
        baseTransformation.values[getIndex(uvec3(r0, g1, b1))] * (1-rd) * gd * bd +
        baseTransformation.values[getIndex(uvec3(r1, g1, b1))] * rd * gd * bd;

    vec3 newColor = color.xyz + transf.xyz - d0transf.xyz;

    imageStore(img, pixelCoords, vec4(newColor/maxBin, color.a));
    //imageStore(img, pixelCoords, vec4(1, 0, 1, color.a));
}
